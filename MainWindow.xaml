<Window x:Class="ImagePresets.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ImagePresets"
        ThemeMode="Dark"
        Title="Presets de imagen" Width="1400" Height="860" MinWidth="900" MinHeight="560"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Barra superior -->
        <WrapPanel Grid.Row="0" Margin="10,8,10,8">
            <Button Content="Abrir imagen…" Click="OpenImage_Click" Margin="0,0,6,4"
                    ToolTip="Empieza una presentación nueva con esta imagen"/>
            <Button Content="＋ Imagen…" Click="AddImage_Click" Margin="0,0,6,4"
                    ToolTip="Añade otra imagen a la presentación (se pasa a ella con un fundido)"/>
            <Button Content="Abrir presets…" Click="OpenPresets_Click" Margin="0,0,6,4"/>
            <Button Content="Guardar" Click="Save_Click" Margin="0,0,6,4" ToolTip="Ctrl+S"/>
            <Button Content="Guardar como…" Click="SaveAs_Click" Margin="0,0,24,4"/>

            <TextBlock Text="Salida:" VerticalAlignment="Center" Margin="0,0,6,4"/>
            <ComboBox x:Name="MonitorBox" Width="250" Margin="0,0,6,4"/>
            <Button x:Name="ProjectButton" Content="▶ Proyectar (F5)" Click="Project_Click" Margin="0,0,24,4" MinWidth="170"/>

            <TextBlock Text="Duración" VerticalAlignment="Center" Margin="0,0,6,4"/>
            <Slider x:Name="DurationSlider" Width="130" Minimum="0.5" Maximum="8" Value="3"
                    SmallChange="0.1" VerticalAlignment="Center" Margin="0,0,4,4" Focusable="False"
                    ToolTip="Duración de los viajes largos (los cortos tardan menos)"/>
            <TextBlock x:Name="DurationText" Width="44" VerticalAlignment="Center" Margin="0,0,16,4"/>

            <TextBlock Text="Alejamiento" VerticalAlignment="Center" Margin="0,0,6,4"/>
            <Slider x:Name="RhoSlider" Width="130" Minimum="0.6" Maximum="2.6" Value="1.4"
                    VerticalAlignment="Center" Margin="0,0,4,4" Focusable="False"
                    ToolTip="Cuánto se aleja la cámara al viajar entre presets"/>
            <TextBlock x:Name="RhoText" Width="36" VerticalAlignment="Center" Margin="0,0,16,4"/>

            <TextBlock Text="Fundido" VerticalAlignment="Center" Margin="0,0,6,4"/>
            <Slider x:Name="FadeSlider" Width="110" Minimum="0" Maximum="3" Value="0.6"
                    VerticalAlignment="Center" Margin="0,0,4,4" Focusable="False"
                    ToolTip="Segundos del fundido a negro al cambiar de imagen (0 = corte directo)"/>
            <TextBlock x:Name="FadeText" Width="44" VerticalAlignment="Center" Margin="0,0,0,4"/>
        </WrapPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="340"/>
            </Grid.ColumnDefinitions>

            <!-- Editor: el marco amarillo es lo que se verá en el monitor de salida -->
            <local:ImageView x:Name="Editor" IsEditor="True"/>

            <!-- Presets -->
            <DockPanel Grid.Column="1" Margin="10,0,10,0">
                <TextBlock DockPanel.Dock="Top" Text="Presets" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,8"/>
                <UniformGrid DockPanel.Dock="Top" Columns="3" Margin="0,0,0,6">
                    <Button Content="＋ Añadir" Click="Add_Click" Margin="0,0,4,0" HorizontalAlignment="Stretch"
                            ToolTip="Guarda el encuadre actual del editor como un preset nuevo"/>
                    <Button Content="Actualizar" Click="Update_Click" Margin="2,0,2,0" HorizontalAlignment="Stretch"
                            ToolTip="Sustituye el preset seleccionado por el encuadre actual del editor"/>
                    <Button Content="Eliminar" Click="Delete_Click" Margin="4,0,0,0" HorizontalAlignment="Stretch"/>
                </UniformGrid>
                <UniformGrid DockPanel.Dock="Top" Columns="2" Margin="0,0,0,8">
                    <Button Content="▲ Subir" Click="MoveUp_Click" Margin="0,0,3,0" HorizontalAlignment="Stretch"/>
                    <Button Content="▼ Bajar" Click="MoveDown_Click" Margin="3,0,0,0" HorizontalAlignment="Stretch"/>
                </UniformGrid>
                <ListBox x:Name="PresetList" HorizontalContentAlignment="Stretch"
                         PreviewMouseLeftButtonDown="PresetList_PreviewMouseLeftButtonDown">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="26"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Number}" FontWeight="Bold" FontSize="15" VerticalAlignment="Center"/>
                                <Border Grid.Column="1" Background="Black" Width="112" Height="63">
                                    <Image Source="{Binding Thumbnail}" Stretch="Uniform"
                                           RenderOptions.BitmapScalingMode="HighQuality"/>
                                </Border>
                                <TextBox Grid.Column="2" Margin="8,0,0,0" VerticalAlignment="Center"
                                         Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Grid>

        <!-- Barra de estado -->
        <DockPanel Grid.Row="2" Margin="10,6,10,8">
            <TextBlock x:Name="FileText" DockPanel.Dock="Right" Opacity="0.7"/>
            <TextBlock Opacity="0.7" TextTrimming="CharacterEllipsis"
                       Text="Rueda: zoom · Arrastrar: mover · Clic en un preset: ir a él · ← → / AvPág RePág / Espacio: anterior y siguiente · 1–9: preset · F5: proyectar · Esc (en la proyección): cerrarla"/>
        </DockPanel>
    </Grid>
</Window>
